ENVIRONMENT=development
DATABASE_URL=sqlite:///./portfolio.db
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
FISH_AUDIO_API_KEY=
# Optional: a voice model ID from fish.audio (for example your own cloned voice); empty uses Fish's default voice
FISH_AUDIO_VOICE_ID=
# Optional: Fish Audio model. Empty uses Fish's default; on the free developer tier use s2.1-pro-free
FISH_AUDIO_MODEL=
GITHUB_TOKEN=
GITHUB_USERNAME=Kuro262004
EVOLVE_SECRET=
CAPTCHA_SECRET=
DAILY_TOKEN_LIMIT=200000
DAILY_VOICE_SECONDS_LIMIT=3600
DAILY_TTS_CHARS_LIMIT=60000
BOOKING_URL=
CORS_ORIGINS=http://localhost:5173

# Local testing: skip the per-IP daily limits for requests from this machine while ENVIRONMENT is development.
# Set to false to see the "used today's live runs" recorded-run fallback locally. Never applies in production.
DEV_BYPASS_LIMITS=true

# Days to keep missions, shared plans and call records before they are deleted automatically (0 = keep forever)
RETENTION_DAYS=30

# Optional: pick the Groq chat model yourself. If it isn't on your account the app tries GROQ_CHAT_FALLBACKS in order.
# Run `python -m app.scripts.check_services` to see which models your key can use.
# GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Optional: prices per million tokens, so the trace inspector and chat can show what each call cost. JSON keyed
# "groq:<model>" / "anthropic:<model>"; copy current numbers from each provider's pricing page. With no entry the
# cost shows as "price not set" (never a guess).
# PRICES_PER_MTOK={"groq:llama-3.3-70b-versatile": {"input": 0.0, "output": 0.0}}

# Plain-language questions in the Ctrl/⌘ + K menu that may use the live model, per visitor per day (after that the
# browser's keyword map answers)
IP_NAVIGATE_PER_DAY=30
