# Set these in Vercel (Project > Settings > Environment Variables), then redeploy. All are baked in at build time.

# The backend's public URL (no trailing slash). Leave empty for local dev: Vite proxies /api and /ws.
VITE_API_URL=

# Your site's public URL. Used for the canonical link, Open Graph / Twitter image URLs and sitemap.xml.
# On Vercel this is filled in automatically from VERCEL_PROJECT_PRODUCTION_URL if you leave it empty.
VITE_SITE_URL=

# Cloudflare Turnstile SITE key (public). Pair with CAPTCHA_SECRET on the backend. Required before AI keys go live.
VITE_TURNSTILE_SITE_KEY=

# Optional: your domain registered in Plausible, to count Call / Mission / Share events without cookies.
VITE_PLAUSIBLE_DOMAIN=
